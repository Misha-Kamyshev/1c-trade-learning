
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ПоказатьВопрос(
		Новый ОписаниеОповещения("ПровестиВсеЗавершение", ЭтотОбъект),
		"Перепровести все документы которые были проведены ранее?",
		РежимДиалогаВопрос.ДаНет
	);
КонецПроцедуры


&НаКлиенте
Процедура ПровестиВсеЗавершение(Результат, ДопПарамерты) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда 
		ПоказатьПредупреждение(,"Проведение документов было отменено");
		Возврат;
	КонецЕсли;
	
	КоличествоОшибок = ПровестиНаСервере();
	
	Если КоличествоОшибок = 0 Тогда
		ПоказатьПредупреждение(,"Проведение завершено успешно!");
	Иначе
		ПоказатьПредупреждение(,СтрШаблон("Проведение было завершено ошибкок проведения: %1", КоличествоОшибок));
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция ПровестиНаСервере()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ 
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	ЖурналДокументов.ЖурналТоваров КАК Док
		|ГДЕ
		|	Док.Проведен
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата"
	);
	Результат = Запрос.Выполнить().Выбрать();
	КоличествоОшибок = ПровестиНаСервереЗавершение(Результат);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ 
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	ЖурналДокументов.ЖурналФинансов КАК Док
		|ГДЕ
		|	Док.Проведен
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата"
	);
	Результат = Запрос.Выполнить().Выбрать();
	КоличествоОшибок = КоличествоОшибок + ПровестиНаСервереЗавершение(Результат);
	
	Возврат КоличествоОшибок;
	
КонецФункции


&НаСервере
Функция ПровестиНаСервереЗавершение(РезультатЗапроса)
	
	КоличествоОшибок = 0;
	
	Пока РезультатЗапроса.Следующий() Цикл
		Попытка
			ДокументОбъект = РезультатЗапроса.Ссылка.ПолучитьОбъект();
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецПопытки;
	КонецЦикла;
	
	Возврат КоличествоОшибок;
	
КонецФункции

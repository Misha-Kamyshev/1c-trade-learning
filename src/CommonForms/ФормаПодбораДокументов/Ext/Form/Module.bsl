
&НаСервере
Процедура ЗаписатьПодборВХранилище()
	Таблица = ?(
		РежимПодбора = Перечисления.РежимПодбораДокументов.ПриходТоваров,
		ДокументыПодбораПрихода,
		ДокументыПодбораРасхода
	);
	ПоместитьВоВременноеХранилище(Таблица.Выгрузить(), АдресВыбранныхДокументов);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьДокументВПодбор(Документ, СуммаДокумента, СуммаОстатка)
	ВыборДокумента = ?(
		РежимПодбора = ПредопределенноеЗначение("Перечисление.РежимПодбораДокументов.ПриходТоваров"),
		ДокументыПодбораПрихода, 
		ДокументыПодбораРасхода
	);
		
	Строки = ВыборДокумента.НайтиСтроки(Новый Структура("Документ", Документ));
	
	Если Строки.Количество() > 0 Тогда
		Возврат;
	Иначе
		Элемент = ВыборДокумента.Добавить();
		Элемент.Документ = Документ;
		Элемент.СуммаДокумента = СуммаДокумента;
		Элемент.СуммаОстатка = СуммаОстатка;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТаблицу()
	Возврат ?(
		РежимПодбора = ПредопределенноеЗначение("Перечисление.РежимПодбораДокументов.ПриходТоваров"),
		Элементы.ПриходТоваров, 
		Элементы.РасходТоваров
	);
КонецФункции


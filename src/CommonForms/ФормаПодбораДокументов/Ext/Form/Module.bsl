&НаКлиенте
Процедура ОКВыполнить(Команда)
	ЗаписатьПодборВХранилище();
	ВладелецФормы.ОбработатьПодбор();
	Закрыть();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимПодбора = Параметры.РежимПодбора;
	Контрагент = Параметры.Контрагент;
	ТекущийДокумент = Параметры.ТекущийДокумент;
	АдресВыбранныхДокументов = Параметры.АдресДокументовВХранилище;
	
	ТаблицаДокументов = ПолучитьИзВременногоХранилища(АдресВыбранныхДокументов);
	
	Если РежимПодбора = Перечисления.РежимПодбораДокументов.ПриходТоваров Тогда
		Элементы.ТаблицыРасхода.Видимость = Ложь;
		
		СписокПриходовТоваров.Параметры.УстановитьЗначениеПараметра("Поставщик", Контрагент);
		СписокПриходовТоваров.Параметры.УстановитьЗначениеПараметра("ТекущийДокумент", ТекущийДокумент);
		
		ДокументыПодбораПрихода.Загрузить(ТаблицаДокументов);
		
	Иначе
		Элементы.ТаблицыПрихода.Видимость = Ложь;
		
		СписокРасходовТовара.Параметры.УстановитьЗначениеПараметра("Покупатель", Контрагент);
		СписокРасходовТовара.Параметры.УстановитьЗначениеПараметра("ТекущийДокумент", ТекущийДокумент);
		
		ДокументыПодбораРасхода.Загрузить(ТаблицаДокументов);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ТоварВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	ДобавитьДокументВПодбор(Значение, ТекущиеДанные.СуммаДокумента, ТекущиеДанные.СуммаОстатка);
КонецПроцедуры

&НаКлиенте
Процедура ТоварНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	Данные = ПолучитьТаблицу().ДанныеСтроки(ПараметрыПеретаскивания.Значение);	
	Выполнение = Данные <> Неопределено;	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыПодбораПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Данные = ПолучитьТаблицу().ДанныеСтроки(ПараметрыПеретаскивания.Значение);
	СтандартнаяОбработка = Данные = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ДокументыПодбораПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = ПолучитьТаблицу().ДанныеСтроки(ПараметрыПеретаскивания.Значение);
	
	ДобавитьДокументВПодбор(ПараметрыПеретаскивания.Значение, ТекущиеДанные.СуммаДокумента, ТекущиеДанные.СуммаОстатка);
КонецПроцедуры

&НаКлиенте
Перем АдресТоваровВХранилище;

&НаКлиенте
Функция ПолучитьТекущуюСтрокуТоваров()
	Возврат Элементы.Товары.ТекущиеДанные;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЦенуТовара(Дата, Товар, ВидЦены)
	
	ЦенаТовара = РегистрыСведений.ЦеныТоваров.ПолучитьПоследнее(
		Дата, Новый Структура("Товар, ВидЦен", Товар, ВидЦены)
	);
	
	Возврат ЦенаТовара.Цена;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВидЦеныПокупателя(Покупатель)
	Возврат Покупатель.ВидЦен;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоУслуга(Товар)
	Возврат ?(Товар.Вид = Перечисления.ВидыТоваров.Услуга, Истина, Ложь);
КонецФункции

&НаСервере
Функция ПоместитьТоварыВХранилище()
	Возврат ПоместитьВоВременноеХранилище(Объект.Товары.Выгрузить(,"Товар,Цена,Количество"), УникальныйИдентификатор);
КонецФункции

&НаСервере
Процедура ПолучитьТоварыИзХранилища(АдресТоваровВХранилище)
	Объект.Товары.Загрузить(ПолучитьИзВременногоХранилища(АдресТоваровВХранилище));
	ПересчитатьЦеныИСуммыТоваров(Ложь);
КонецПроцедуры

&НаСервере
Процедура ПересчитатьЦеныИСуммыТоваров(ПересчитатьВсе)
	Товары = Новый Массив;
	Для Каждого Стр Из Объект.Товары Цикл
		Товары.Добавить(Стр.Товар);
	КонецЦикла;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ 
		|	ЦеныТоваров.Товар КАК Товар,
		|	ЦеныТоваров.Цена КАК Цена
		|ИЗ 
		|	РегистрСведений.ЦеныТоваров.СрезПоследних(
		|		&Дата, 
		|		ВидЦен = &ВидЦены 
		|		И Товар В (&Товары)
		|	) КАК ЦеныТоваров"
	);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("ВидЦены", Объект.ВидЦен);
	Запрос.УстановитьПараметр("Товары", Товары);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Индексы.Добавить("Товар");
	
	Для Каждого Стр Из Объект.Товары Цикл
		Если Стр.Цена = 0 ИЛИ ПересчитатьВсе Тогда
			ЦенаТовара = РезультатЗапроса.Найти(Стр.Товар, "Товар");
			Если ЦенаТовара <> Неопределено Тогда
				Стр.Цена = ЦенаТовара.Цена;
			Иначе
				Стр.Цена = 0;
			КонецЕсли;
		КонецЕсли;
		
		Стр.ЭтоУслуга = ЭтоУслуга(Стр.Товар);
		Стр.Количество = ?(Стр.ЭтоУслуга, 1, Стр.Количество);
		Стр.Сумма = Стр.Цена * Стр.Количество;
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////////////////////////////////
//											ОБРАБОТЧИКИ СОБЫТИЙ											  //
////////////////////////////////////////////////////////////////////////////////////////////////////////////
&НаКлиенте
Процедура ТоварыТоварПриИзменении()
	
	Стр = ПолучитьТекущуюСтрокуТоваров();
	Стр.ЭтоУслуга = ЭтоУслуга(Стр.Товар);
	Стр.Цена = ПолучитьЦенуТовара(Объект.Дата, Стр.Товар, Объект.ВидЦен);
	Стр.Количество = ?(Стр.ЭтоУслуга ИЛИ Стр.Количество = 0, 1, Стр.Количество);
	Стр.Сумма = Стр.Количество * Стр.Цена;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении()
	
	Стр = ПолучитьТекущуюСтрокуТоваров();
	Стр.Сумма = Стр.Количество * Стр.Цена;
	
КонецПроцедуры

&НаКлиенте
Процедура ПокупательПриИзменении()
	
	Объект.ВидЦен = ПолучитьВидЦеныПокупателя(Объект.Покупатель);
	ВидЦенПриИзменении();

КонецПроцедуры

&НаКлиенте
Процедура ВидЦенПриИзменении()
	Если Объект.Товары.Количество() > 0 Тогда
		ПересчитатьЦеныИСуммыТоваров(Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаПодбор(Команда)
	АдресТоваровВХранилище = ПоместитьТоварыВХранилище();
	ПараметрыПодбора = Новый Структура("АдресТоваровДокумента,ВидЦен", АдресТоваровВХранилище, Объект.ВидЦен);
	ФормаПодбора = ОткрытьФорму("ОбщаяФорма.ФормаПодбораТовара", ПараметрыПодбора, ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПодбор() Экспорт
	ПолучитьТоварыИзХранилища(АдресТоваровВХранилище);
КонецПроцедуры

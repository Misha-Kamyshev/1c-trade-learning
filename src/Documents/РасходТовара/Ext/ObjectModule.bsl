
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения
		И РаботаСДокументами.ЕстьОплата(Ссылка) Тогда
		Сообщить("Нельзя отменить проведение: по документу есть оплата.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Оплачено = 0;
	
	Если Не ЭтоНовый() И Ссылка.Проведен Тогда
		СуммаДоИзменения = Ссылка.СуммаДокумента;
		Остаток = РаботаСДокументами.ОстатокОплаты(Ссылка);
		Оплачено = СуммаДоИзменения - Остаток;
	КонецЕсли;
	
	Если Товары.Итог("Сумма") < Оплачено Тогда
		Сообщить(
			"Невозможно изменить документ, сумма документа ниже чем уже оплачено."
			+ Символы.ПС + "Оплачено: " + Оплачено
		);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	СуммаДокумента = Товары.Итог("Сумма");
	
КонецПроцедуры


Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ТоварныеЗапасы.Записывать = Истина;
	Движения.Взаиморасчеты.Записывать = Истина;
	
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Если ТекСтрокаТовары.Товар.Вид = Перечисления.ВидыТоваров.Услуга Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.ТоварныеЗапасы.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаТовары.Товар;
		Движение.Склад = Склад;
		Движение.Количество = ТекСтрокаТовары.Количество;
		
	КонецЦикла;
	
		Движение = Движения.Взаиморасчеты.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Контрагент = Покупатель;
		Движение.ДокументРасчетов = Ссылка;
		Движение.Сумма = Товары.Итог("Сумма"); 

КонецПроцедуры


Процедура ПередУдалением(Отказ)
	Если РаботаСДокументами.ЕстьОплата(Ссылка) Тогда
		Сообщить("Невозможно удалить документ, который используется");
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры


	
	
	
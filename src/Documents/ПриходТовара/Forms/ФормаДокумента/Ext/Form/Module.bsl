
&НаСервереБезКонтекста
Функция ПолучитьЦенуТовара(Дата, Товар, ВидЦен)
	
	ЦенаТовара = РегистрыСведений.ЦеныТоваров.ПолучитьПоследнее(
		Дата, Новый Структура("Товар, ВидЦен", Товар, ВидЦен)
	);
	
	Возврат ЦенаТовара.Цена;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТекущуюСтрокуТовары()
	Возврат Элементы.Товары.ТекущиеДанные;
КонецФункции

&НаКлиенте
Процедура ТоварыТоварПриИзменении(Элемент)
	
	Стр = ПолучитьТекущуюСтрокуТовары();
	Стр.Цена = ПолучитьЦенуТовара(Объект.Дата, Стр.Товар, Объект.ВидЦен);
	Стр.Сумма = Стр.Количество * Стр.Цена;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	Стр = ПолучитьТекущуюСтрокуТовары();
	Стр.Сумма = Стр.Количество * Стр.Цена;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоставщикПриИзменении(Элемент)
	Объект.ВидЦен = ПолучитьВидЦеныПоставщика(Объект.Поставщик);
	ПересчитатьЦеныИСуммы();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВидЦеныПоставщика(Поставщик)
	Возврат Поставщик.ВидЦен;
КонецФункции

&НаСервере
Процедура ПересчитатьЦеныИСуммы()
	
	Для Каждого Стр Из Объект.Товары Цикл
		Стр.Цена = ПолучитьЦенуТовара(Объект.Дата, Стр.Товар, Объект.ВидЦен);
		Стр.Сумма = Стр.Количество * Стр.Цена;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидЦенПриИзменении(Элемент)
	ПересчитатьЦеныИСуммы();
КонецПроцедуры

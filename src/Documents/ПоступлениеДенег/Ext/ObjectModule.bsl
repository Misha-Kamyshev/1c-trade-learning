
Процедура ОбработкаПроведения(Отказ, Режим)

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.Взаиморасчеты");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.ИсточникДанных = ДокументыРасходовТоваров;
	Элемент.ИспользоватьИзИсточникаДанных("ДокументРасчетов", "Документ");
	Блокировка.Заблокировать();
	
	Движения.Взаиморасчеты.Записывать = Истина;
	МассивДокументов = Новый Массив;
	
	Для Каждого Стр Из ДокументыРасходовТоваров Цикл 
		Движение = Движения.Взаиморасчеты.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Контрагент = Покупатель;
		Движение.ДокументРасчетов = Стр.Документ;
		Движение.Сумма = Стр.СуммаОплаты;
		
		МассивДокументов.Добавить(Стр.Документ);
	КонецЦикла;

	Движения.Взаиморасчеты.Записать();
	
	Остатки = РаботаСДокументамиОплат.ПолучитьОстатокПоОплате(МассивДокументов);
	ДокументыСПереплатой = "";
	
	Для Каждого Стр Из Остатки Цикл
		Если Стр.Сумма > 0 Тогда
			ДокументыСПереплатой = ДокументыСПереплатой + Строка(Стр.Документ) + Символы.ПС;
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ДокументыСПереплатой <> "" Тогда 
		Сообщить(
			"Не возможно провести документ так как после проведения у документов:" + Символы.ПС
			+ ДокументыСПереплатой + "будет переплата"
		);
	КонецЕсли;
	
КонецПроцедуры

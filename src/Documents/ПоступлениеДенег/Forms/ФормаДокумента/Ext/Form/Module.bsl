
&НаКлиенте
Перем АдресДокументовВХранилище;

&НаКлиенте
Функция ПолучитьТекущуюСтрокуДокументов()
	Возврат Элементы.ДокументыРасходовТоваров.ТекущиеДанные;
КонецФункции

&НаКлиенте
Процедура ПроверитьСуммуДокументов()
	Если СуммаОплатыИзменена Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Сумма = РаботаСДокументамиОплат.ПересчитатьСуммуДокументов(
		Объект.ДокументыРасходовТоваров
	);
КонецПроцедуры

&НаСервере
Функция ПоместитьДокументыВХранилище()
	Возврат ПоместитьВоВременноеХранилище(Объект.ДокументыРасходовТоваров.Выгрузить(, "Документ, СуммаДокумента, СуммаОстатка"), УникальныйИдентификатор);
КонецФункции

&НаСервере
Процедура ПолучитьДокументыИзХранилища(АдресДокументовВХранилище)
	Объект.ДокументыРасходовТоваров.Загрузить(ПолучитьИзВременногоХранилища(АдресДокументовВХранилище));
КонецПроцедуры

&НаСервере
Процедура УдалитьСтроки()
	
	НаУдаление = РаботаСДокументамиОплат
		.ПолучитьПустыеСтрокиИПовторыНаУдаление(Объект.ДокументыРасходовТоваров);
		
	Для Каждого Индекс Из НаУдаление Цикл
		Объект.ДокументыРасходовТоваров.Удалить(Индекс);
	КонецЦикла;
	
КонецПроцедуры


//////////////////////////////////////////////////////////////////////////////////////////////////////////
//											ОБРАБОТЧИКИ СОБЫТИЙ											//
//////////////////////////////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗаписьПодтверждена Тогда
		ЗаписьПодтверждена = Ложь;
		Возврат;
	КонецЕсли;
	
	Если Не СуммаРаспределена Тогда
		ПоказатьПредупреждение(, "Перед проведением необходимо распределить сумму");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	КоличествоДокументов = 0;
	Для Каждого Стр Из Объект.ДокументыРасходовТоваров Цикл
		Если Стр.СуммаОплаты = 0 Тогда
			КоличествоДокументов = КоличествоДокументов + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоДокументов > 0 Тогда
		Отказ = Истина;
		ДопПараментры = Новый Структура("ПараметрыЗаписи", ПараметрыЗаписи);
		ПоказатьВопрос(
			Новый ОписаниеОповещения("ПередЗаписьюЗавершение", ЭтотОбъект, ДопПараментры), 
			"Перед проведением будут удалены строки с нулевой суммой оплаты (" + КоличествоДокументов + "). Продолжить?",
			РежимДиалогаВопрос.ДаНет
		);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписьюЗавершение(Результат, ДопПараментры)
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = Объект.ДокументыРасходовТоваров.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Объект.ДокументыРасходовТоваров[Индекс].СуммаОплаты = 0 Тогда
			Объект.ДокументыРасходовТоваров.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	ЗаписьПодтверждена = Истина;
	Записать(ДопПараментры.ПараметрыЗаписи);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СуммаОплатыИзменена = Объект.Сумма > 0 
		И Объект.Сумма <> Объект.ДокументыРасходовТоваров.Итог("СуммаОстатка");
	
	СуммаРаспределена = РаботаСДокументамиОплат.ПроверитьРаспределениеСуммы(
		Объект.ДокументыРасходовТоваров, 
		Объект.Сумма
	);
	ЗаписьПодтверждена = Ложь;
	
КонецПроцедуры


&НаКлиенте
Процедура ПодборДокументов(Команда)
	УдалитьСтроки();
	
	Если Не ЗначениеЗаполнено(Объект.Покупатель) Тогда
		ПоказатьПредупреждение(,"Нельзя выполнить подбор без указания покупателя");
		Возврат;
	КонецЕсли;
	
	АдресДокументовВХранилище = ПоместитьДокументыВХранилище();
	ПараметрыПодбора = Новый Структура(
		"АдресДокументовВХранилище,Дата,РежимПодбора,Контрагент,ТекущийДокумент", 
		АдресДокументовВХранилище, 
		Объект.Дата,
		ПредопределенноеЗначение("Перечисление.РежимПодбораДокументов.РасходТоваров"),
		Объект.Покупатель,
		Объект.Ссылка
	);
	ОткрытьФорму(
		"ОбщаяФорма.ФормаПодбораДокументов", 
		ПараметрыПодбора,
		ЭтотОбъект
	);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПодбор() Экспорт
	ПолучитьДокументыИзХранилища(АдресДокументовВХранилище);
	ПроверитьСуммуДокументов();
	СуммаРаспределена = Ложь;
КонецПроцедуры


&НаКлиенте
Процедура РаспределитьСумму(Команда)
	
	УдалитьСтроки();
	Объект.ДокументыРасходовТоваров.Сортировать("ДатаДокумента");
	ПроверитьСуммуДокументов();
	
	РезультатРаспределения = РаботаСДокументамиОплат.РаспределитьСуммуПоДокументам(
		Объект.Сумма, 
		Объект.ДокументыРасходовТоваров
	);
	
	Если Не РезультатРаспределения.Проверка Тогда
		ПоказатьПредупреждение(, "Сумма оплаты превышает задолженность по выбранным документам." 
			+ Символы.ПС + "Уменьшите сумму или добавьте ещё документы в подбор.");
	Иначе
		СуммаРаспределена = Истина;
		Для Индекс = 0 По Объект.ДокументыРасходовТоваров.Количество() - 1 Цикл
			Стр = Объект.ДокументыРасходовТоваров[Индекс];
			Стр.СуммаОплаты = РезультатРаспределения.МассивСумм[Индекс];
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСумму(Команда)
	
	СуммаОплатыИзменена = Ложь;
	СуммаРаспределена = Ложь;
	
	ПроверитьСуммуДокументов();
	
	Для Каждого Стр Из Объект.ДокументыРасходовТоваров Цикл
		Стр.СуммаОплаты = 0;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ДокументыПриходовТоваровДокументПриИзменении(Элемент)
	
	Стр = ПолучитьТекущуюСтрокуДокументов();
	
	СуммаОстатка = РаботаСДокументамиОплат.ПолучитьСуммуОстатка(Стр.Документ, Объект.Ссылка);
	Если СуммаОстатка = 0 Тогда
		ПоказатьПредупреждение(,"Этот документ уже полностью оплачен. Он будет удален");
		Объект.ДокументыРасходовТоваров.Удалить(Стр);
		ПроверитьСуммуДокументов();
		Возврат;
	КонецЕсли;
	
	Стр.СуммаДокумента = РаботаСДокументамиОплат.ПолучитьСуммуДокумента(Стр.Документ);
	Стр.СуммаОстатка = СуммаОстатка;
	СуммаРаспределена = Ложь;
	ПроверитьСуммуДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыПриходовТоваровПослеУдаления(Элемент)
	ПроверитьСуммуДокументов();
КонецПроцедуры


&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	СуммаОплатыИзменена = Объект.Сумма > 0;
	СуммаРаспределена = Ложь;
	Для Каждого Стр Из Объект.ДокументыРасходовТоваров Цикл
		Стр.СуммаОплаты = 0;
	КонецЦикла;
КонецПроцедуры

	Данные.ТипДокумента КАК ТипДокумента,
	ВЫБОР
		КОГДА Данные.ТипДокумента = "Поступление"
			ТОГДА -Данные.СуммаОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК МыДолжны,
	ВЫБОР
		КОГДА Данные.ТипДокумента = "Продажа"
			ТОГДА Данные.СуммаОстаток

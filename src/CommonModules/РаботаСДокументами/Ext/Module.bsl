
Функция ЕстьОплата(Документ) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Поле
		|ИЗ
		|	РегистрНакопления.Взаиморасчеты КАК Взаиморасчеты
		|ГДЕ
		|	Взаиморасчеты.Регистратор <> &Документ
		|	И Взаиморасчеты.ДокументРасчетов = &Документ"
	);
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ОстатокОплаты(Документ) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ЕСТЬNULL(Остатки.СуммаОстаток, 0) КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления.Взаиморасчеты.Остатки(, ДокументРасчетов = &Документ) КАК Остатки"
	);
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Макс(Выборка.СуммаОстаток, -Выборка.СуммаОстаток);
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции


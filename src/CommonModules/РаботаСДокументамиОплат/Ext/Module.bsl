
Функция ПолучитьСуммуДокумента(Знач ПараметрДокумент) Экспорт
	Возврат ПараметрДокумент.СуммаДокумента;
КонецФункции

Функция ПолучитьСуммуОстатка(Знач ПараметрДокумент, Знач ТекущийДокумент) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ 
		|	ЕСТЬNULL(
		|		СУММА(
		|			ВЫБОР КОГДА Взаиморасчеты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)ТОГДА 
		|				Взаиморасчеты.Сумма
		|			ИНАЧЕ 
		|				-Взаиморасчеты.Сумма
		|			КОНЕЦ
		|		),
		|		0
		|	) КАК Остаток
		|ИЗ
		|	РегистрНакопления.Взаиморасчеты КАК Взаиморасчеты
		|ГДЕ
		|	Взаиморасчеты.ДокументРасчетов = &ДокументРасчетов
		|	И Взаиморасчеты.Регистратор <> &ТекущийДокумент"
	);
	Запрос.УстановитьПараметр("ДокументРасчетов", ПараметрДокумент);
	Запрос.УстановитьПараметр("ТекущийДокумент", ТекущийДокумент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.Остаток;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ПересчитатьСуммуДокументов(Знач ПараметрДокументы) Экспорт

	Сумма = 0;

	Для Каждого Стр Из ПараметрДокументы Цикл
		Сумма = Сумма + Стр.СуммаОстатка;
	КонецЦикла;
	
	Возврат Сумма;
	
КонецФункции

Функция ПолучитьПустыеСтрокиИПовторыНаУдаление(Знач ПараметрДокументы) Экспорт
	
	УникальныеЭлементы = Новый Соответствие;
	СтрокиНаУдаление = Новый Массив;
	
	Для Индекс = 0 По ПараметрДокументы.Количество() - 1 Цикл
		Документ = ПараметрДокументы[Индекс].Документ;
		
		Если Не ЗначениеЗаполнено(Документ) Или УникальныеЭлементы[Документ] <> Неопределено Тогда
			СтрокиНаУдаление.Вставить(0, Индекс);
		Иначе
			УникальныеЭлементы.Вставить(Документ, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрокиНаУдаление;
	
КонецФункции

Функция ПроверитьРаспределениеСуммы(Знач ПараметрДокументы, Знач ПараметрСумма) Экспорт
	
	Сумма = 0;
	Для Каждого Стр Из ПараметрДокументы Цикл
		Сумма = Сумма + Стр.СуммаОплаты;
	КонецЦикла;

	Возврат Сумма = ПараметрСумма;

КонецФункции

Функция РаспределитьСуммуПоДокументам(Знач ПараметрСумма, Знач ПараметрДокументы) Экспорт
	
	Если ПараметрСумма = 0 Или ПараметрДокументы.Количество() = 0 Тогда
		Возврат Новый Структура("Проверка", Ложь);
	КонецЕсли;
	
	МассивСуммОплат = Новый Массив;
	
	Для Каждого Стр Из ПараметрДокументы Цикл
		СуммаОплаты = Мин(ПараметрСумма, Стр.СуммаОстатка);
		МассивСуммОплат.Добавить(СуммаОплаты);
		ПараметрСумма = ПараметрСумма - СуммаОплаты;
	КонецЦикла;
		
	Возврат Новый Структура("МассивСумм, Проверка", МассивСуммОплат, ПараметрСумма = 0);
	
КонецФункции

Функция ПолучитьОстатокПоОплате(Знач МассивДокументов) Экспорт
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Остатки.ДокументРасчетов КАК Документ,
		|	Остатки.СуммаОстаток КАК Сумма
		|ИЗ
		|	РегистрНакопления.Взаиморасчеты.Остатки(, ДокументРасчетов В (&МассивДокументов)) КАК Остатки"
	);
	
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
	
КонецФункции
